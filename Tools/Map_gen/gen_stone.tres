code = "shader_type canvas_item;
render_mode blend_mix;

uniform sampler2D curve_frg_8 : repeat_disable;


// Ellipse
#include \"res://addons/ShaderLib/Procedural/Procedural.gdshaderinc\"
// SimpleNoise
#include \"res://addons/ShaderLib/Procedural/Procedural.gdshaderinc\"
// Voronoi
#include \"res://addons/ShaderLib/Procedural/Procedural.gdshaderinc\"

void fragment() {
// Vector3Constant:2
	vec3 n_out2p0 = vec3(0.500000, 0.500000, 0.500000);


	float n_out3p0;
// Ellipse:3
	float n_in3p1 = 1.00000;
	float n_in3p2 = 1.00000;
	{
		n_out3p0 = ellipse_shape(UV, n_in3p1, n_in3p2);
	}


	float n_out6p0;
// SimpleNoise:6
	float n_in6p1 = 10.00000;
	int n_in6p2 = 10;
	{
		n_out6p0 = simple_noise(UV, n_in6p1, n_in6p2);
	}


	float n_out4p0;
	float n_out4p1;
// Voronoi:4
	float n_in4p1 = 5.00000;
	{
		voronoi_noise(vec2(n_out6p0), n_in4p1, n_out6p0, 0, 0., n_out4p0, n_out4p1);
	}


// CurveTexture:8
	float n_out8p0 = texture(curve_frg_8, vec2(n_out4p0)).r;


// FloatOp:9
	float n_out9p0 = n_out3p0 * n_out8p0;


// Output:0
	COLOR.rgb = n_out2p0;
	COLOR.a = n_out9p0;


}
"
