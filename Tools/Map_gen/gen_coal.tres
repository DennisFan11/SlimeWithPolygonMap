code = "shader_type canvas_item;
render_mode blend_mix;

uniform sampler2D curve_frg_7 : repeat_disable;


// Ellipse
#include \"res://addons/ShaderLib/Procedural/Procedural.gdshaderinc\"
// SimpleNoise
#include \"res://addons/ShaderLib/Procedural/Procedural.gdshaderinc\"
// GradientNoise
#include \"res://addons/ShaderLib/Procedural/Procedural.gdshaderinc\"

void fragment() {
// Vector3Constant:2
	vec3 n_out2p0 = vec3(0.100000, 0.100000, 0.100000);


	float n_out3p0;
// Ellipse:3
	float n_in3p1 = 1.00000;
	float n_in3p2 = 1.00000;
	{
		n_out3p0 = ellipse_shape(UV, n_in3p1, n_in3p2);
	}


	float n_out6p0;
// SimpleNoise:6
	float n_in6p1 = 3.00000;
	int n_in6p2 = 20;
	{
		n_out6p0 = simple_noise(UV, n_in6p1, n_in6p2);
	}


	float n_out4p0;
// GradientNoise:4
	float n_in4p1 = 20.00000;
	{
		n_out4p0 = gradient_noise(vec2(n_out6p0), n_in4p1);
	}


// CurveTexture:7
	float n_out7p0 = texture(curve_frg_7, vec2(n_out4p0)).r;


// FloatOp:8
	float n_out8p0 = n_out3p0 * n_out7p0;


// Output:0
	COLOR.rgb = n_out2p0;
	COLOR.a = n_out8p0;


}
"
