code = "shader_type canvas_item;
render_mode blend_mix;

uniform sampler2D curve_frg_4 : repeat_disable;


// Ellipse
#include \"res://addons/ShaderLib/Procedural/Procedural.gdshaderinc\"
// GradientNoise
#include \"res://addons/ShaderLib/Procedural/Procedural.gdshaderinc\"

void fragment() {
// Vector3Constant:2
	vec3 n_out2p0 = vec3(0.914000, 0.600000, 0.300000);


	float n_out3p0;
// Ellipse:3
	float n_in3p1 = 1.00000;
	float n_in3p2 = 1.00000;
	{
		n_out3p0 = ellipse_shape(UV, n_in3p1, n_in3p2);
	}


	float n_out7p0;
// GradientNoise:7
	float n_in7p1 = 20.00000;
	{
		n_out7p0 = gradient_noise(UV, n_in7p1);
	}


// CurveTexture:4
	float n_out4p0 = texture(curve_frg_4, vec2(n_out7p0)).r;


// FloatOp:5
	float n_out5p0 = n_out3p0 * n_out4p0;


// Output:0
	COLOR.rgb = n_out2p0;
	COLOR.a = n_out5p0;


}
"
