[resource]
code = "shader_type canvas_item;
render_mode blend_mix;

uniform vec3 Stone = vec3(0.518000, 0.388000, 0.345000);
uniform sampler2D curve_frg_33 : repeat_disable;
uniform vec3 Iorn = vec3(0.500000, 0.500000, 0.500000);
uniform sampler2D curve_frg_48 : repeat_disable;
uniform vec3 Copper = vec3(0.682000, 0.369000, 0.243000);
uniform sampler2D curve_frg_49 : repeat_disable;
uniform vec3 Lumium = vec3(0.047000, 0.522000, 0.600000);
uniform sampler2D curve_frg_53 : repeat_disable;
uniform vec3 Coal = vec3(0.100000, 0.100000, 0.100000);
uniform sampler2D curve_frg_59 : repeat_disable;


// Spherize
#include \"res://addons/ShaderLib/UV/UV.gdshaderinc\"
// SimpleNoise
#include \"res://addons/ShaderLib/Procedural/Procedural.gdshaderinc\"
// GyroidNoise
#include \"res://addons/ShaderLib/Procedural/Procedural.gdshaderinc\"
// GradientNoise
#include \"res://addons/ShaderLib/Procedural/Procedural.gdshaderinc\"
// Voronoi
#include \"res://addons/ShaderLib/Procedural/Procedural.gdshaderinc\"
// Ellipse
#include \"res://addons/ShaderLib/Procedural/Procedural.gdshaderinc\"

void fragment() {
// Vector3Parameter:70
	vec3 n_out70p0 = Stone;


// Input:77
	float n_out77p0 = TIME;


	vec2 n_out74p0;
// Spherize:74
	vec2 n_in74p1 = vec2(0.50000, 0.50000);
	float n_in74p2 = 20.00000;
	vec2 n_in74p3 = vec2(0.00000, 0.00000);
	{
		n_out74p0 = spherize_uv(UV, n_in74p1, n_in74p2, n_in74p3);
	}
	float n_out74p1 = n_out74p0.r;
	float n_out74p2 = n_out74p0.g;


// FloatOp:80
	float n_out80p0 = n_out77p0 + n_out74p1;


// VectorCompose:78
	vec2 n_out78p0 = vec2(n_out80p0, n_out74p2);


// Reroute:75
	vec2 n_out75p0 = n_out78p0;


	float n_out10p0;
// SimpleNoise:10
	float n_in10p1 = 20.00000;
	int n_in10p2 = 6;
	{
		n_out10p0 = simple_noise(n_out75p0, n_in10p1, n_in10p2);
	}


// CurveTexture:33
	float n_out33p0 = texture(curve_frg_33, vec2(n_out10p0)).r;


// IntConstant:32
	int n_out32p0 = 2;


// FloatOp:7
	float n_out7p0 = n_out33p0 * float(n_out32p0);


// FloatFunc:8
	float n_out8p0 = floor(n_out7p0);


// FloatOp:9
	float n_out9p0 = n_out8p0 / float(n_out32p0);


// FloatFunc:21
	float n_out21p0 = ceil(n_out9p0);


// VectorOp:29
	vec3 n_out29p0 = n_out70p0 * vec3(n_out21p0);


// Vector3Parameter:67
	vec3 n_out67p0 = Iorn;


	float n_out13p0;
// GyroidNoise:13
	float n_in13p1 = 5.00000;
	vec2 n_in13p2 = vec2(1.00000, 1.00000);
	float n_in13p3 = 1.77500;
	float n_in13p4 = 0.69500;
	{
		n_out13p0 = gyroid_noise(n_out75p0, n_in13p1, n_in13p2, n_in13p3, n_in13p4);
	}


	float n_out12p0;
// SimpleNoise:12
	float n_in12p1 = 20.00000;
	{
		n_out12p0 = simple_noise(n_out75p0, n_in12p1, int(n_out13p0));
	}


// CurveTexture:48
	float n_out48p0 = texture(curve_frg_48, vec2(n_out12p0)).r;


// IntConstant:18
	int n_out18p0 = 3;


// FloatOp:16
	float n_out16p0 = n_out48p0 * float(n_out18p0);


// FloatFunc:15
	float n_out15p0 = floor(n_out16p0);


// FloatOp:17
	float n_out17p0 = n_out15p0 / float(n_out18p0);


// FloatFunc:22
	float n_out22p0 = ceil(n_out17p0);


// VectorOp:30
	vec3 n_out30p0 = n_out67p0 * vec3(n_out22p0);


// Mix:20
	vec3 n_out20p0 = mix(n_out29p0, n_out30p0, vec3(n_out22p0));


// Vector3Parameter:68
	vec3 n_out68p0 = Copper;


	float n_out44p0;
// GradientNoise:44
	float n_in44p1 = 20.00000;
	{
		n_out44p0 = gradient_noise(n_out75p0, n_in44p1);
	}


	float n_out42p0;
	float n_out42p1;
// Voronoi:42
	float n_in42p1 = 4.00000;
	float n_in42p2 = 2.00000;
	{
		voronoi_noise(vec2(n_out44p0), n_in42p1, n_in42p2, 0, 0., n_out42p0, n_out42p1);
	}


// CurveTexture:49
	float n_out49p0 = texture(curve_frg_49, vec2(n_out42p1)).r;


// FloatFunc:51
	float n_out51p0 = floor(n_out49p0);


// VectorOp:47
	vec3 n_out47p0 = n_out68p0 * vec3(n_out51p0);


// Mix:45
	vec3 n_out45p0 = mix(n_out20p0, n_out47p0, vec3(n_out51p0));


// Vector3Parameter:69
	vec3 n_out69p0 = Lumium;


	float n_out35p0;
// SimpleNoise:35
	float n_in35p1 = 20.00000;
	int n_in35p2 = 30;
	{
		n_out35p0 = simple_noise(n_out75p0, n_in35p1, n_in35p2);
	}


// CurveTexture:53
	float n_out53p0 = texture(curve_frg_53, vec2(n_out35p0)).r;


// FloatFunc:54
	float n_out54p0 = ceil(n_out53p0);


// VectorOp:56
	vec3 n_out56p0 = n_out69p0 * vec3(n_out54p0);


// Mix:57
	vec3 n_out57p0 = mix(n_out45p0, n_out56p0, vec3(n_out54p0));


// Vector3Parameter:71
	vec3 n_out71p0 = Coal;


// VectorDecompose:76
	float n_out76p0 = n_out75p0.x;
	float n_out76p1 = n_out75p0.y;


// FloatOp:65
	float n_in65p1 = 1.00000;
	float n_out65p0 = n_out76p0 + n_in65p1;


// VectorCompose:66
	vec2 n_out66p0 = vec2(n_out65p0, n_out76p1);


	float n_out58p0;
// SimpleNoise:58
	float n_in58p1 = 20.00000;
	int n_in58p2 = 30;
	{
		n_out58p0 = simple_noise(n_out66p0, n_in58p1, n_in58p2);
	}


// CurveTexture:59
	float n_out59p0 = texture(curve_frg_59, vec2(n_out58p0)).r;


// FloatFunc:62
	float n_out62p0 = ceil(n_out59p0);


// VectorOp:61
	vec3 n_out61p0 = n_out71p0 * vec3(n_out62p0);


// Mix:63
	vec3 n_out63p0 = mix(n_out57p0, n_out61p0, vec3(n_out62p0));


	float n_out23p0;
// Ellipse:23
	float n_in23p1 = 1.00000;
	float n_in23p2 = 1.00000;
	{
		n_out23p0 = ellipse_shape(UV, n_in23p1, n_in23p2);
	}


// Output:0
	COLOR.rgb = n_out63p0;
	COLOR.a = n_out23p0;


}
"
